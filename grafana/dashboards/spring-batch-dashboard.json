{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "target": { "limit": 100, "matchAny": false, "tags": [], "type": "dashboard" }, "type": "dashboard" } ] },
  "editable": true, "fiscalYearStartMonth": 0, "graphTooltip": 0, "id": null, "links": [], "liveNow": false,
  "panels": [
    {
      "title": "Current Job Throughput (Items/Sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(spring_batch_item_read_count_total{job_name=~\"$job_name\"}[1m])", "legendFormat": "{{step_name}} - Read Speed", "refId": "A" },
        { "expr": "rate(spring_batch_item_write_count_total{job_name=~\"$job_name\"}[1m])", "legendFormat": "{{step_name}} - Write Speed", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } }
    },
    {
      "title": "Total Items Processed (Current Run)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum by (step_name) (spring_batch_item_read_count_total{job_name=~\"$job_name\"})", "legendFormat": "{{step_name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } } }
    },
    {
      "title": "Step Execution Durations",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "spring_batch_step_duration_seconds_sum{job_name=~\"$job_name\"}", "legendFormat": "{{step_name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Errors & Failures",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(spring_batch_item_process_failure_count_total{job_name=~\"$job_name\"})", "legendFormat": "Process Failures", "refId": "A" },
        { "expr": "sum(spring_batch_step_failure_count_total{job_name=~\"$job_name\"})", "legendFormat": "Step Failures", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    }
  ],
  "templating": {
    "list": [
      { "name": "job_name", "type": "query", "datasource": { "type": "prometheus" }, "definition": "label_values(spring_batch_job_duration_seconds_count, job_name)", "hide": 0, "includeAll": true, "multi": true, "refresh": 1, "sort": 1 }
    ]
  },
  "timezone": "browser",
  "title": "Spring Batch Monitoring - Similarity Job",
  "version": 1
}